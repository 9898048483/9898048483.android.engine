#:kivy 2.2.0
#:import NoTransition kivy.uix.screenmanager.NoTransition
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<SecurityTheme>:
    # Theme Palette Variables (Dark Cyber / High Contrast Light / Tactical Amber)
    bg_primary: 0.05, 0.05, 0.08, 1.0
    bg_surface: 0.09, 0.10, 0.14, 1.0
    bg_card: 0.12, 0.13, 0.18, 1.0
    accent_emerald: 0.06, 0.80, 0.58, 1.0
    accent_cyan: 0.08, 0.70, 0.95, 1.0
    accent_rose: 0.94, 0.27, 0.42, 1.0
    accent_amber: 0.96, 0.65, 0.14, 1.0
    text_primary: 0.96, 0.96, 0.98, 1.0
    text_muted: 0.60, 0.64, 0.72, 1.0
    border_color: 0.20, 0.22, 0.30, 1.0

<SecureButton@Button>:
    font_size: sp(14)
    font_name: 'Roboto-Medium'
    bold: True
    background_color: (0, 0, 0, 0)
    background_normal: ''
    canvas.before:
        Color:
            rgba: (0.06, 0.80, 0.58, 0.9) if self.state == 'normal' else (0.04, 0.65, 0.46, 1.0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10), dp(10), dp(10), dp(10)]

<DangerButton@Button>:
    font_size: sp(14)
    font_name: 'Roboto-Medium'
    bold: True
    background_color: (0, 0, 0, 0)
    background_normal: ''
    canvas.before:
        Color:
            rgba: (0.94, 0.27, 0.42, 0.9) if self.state == 'normal' else (0.80, 0.20, 0.35, 1.0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10), dp(10), dp(10), dp(10)]

<GlassCard@BoxLayout>:
    orientation: 'vertical'
    padding: dp(16)
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: (0.12, 0.13, 0.18, 0.85)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14), dp(14), dp(14), dp(14)]
        Color:
            rgba: (0.20, 0.22, 0.30, 0.6)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(14))
            width: dp(1.2)

<MainSecureScreen>:
    name: 'main_secure_space'
    canvas.before:
        Color:
            rgba: app.theme_bg
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [dp(20), dp(24), dp(20), dp(20)]
        spacing: dp(16)

        # Top App Bar & Security Banner
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            spacing: dp(12)

            BoxLayout:
                orientation: 'vertical'
                Label:
                    text: 'AI SECURE SPACE'
                    font_size: sp(18)
                    bold: True
                    color: app.theme_text
                    halign: 'left'
                    text_size: self.size
                Label:
                    text: 'Hardware KeyStore • OpenGL ES 3.0 • Tor Active'
                    font_size: sp(11)
                    color: app.theme_muted
                    halign: 'left'
                    text_size: self.size

            # Screenshot Prevention Flag (FLAG_SECURE) Status Badge
            Button:
                size_hint_x: None
                width: dp(140)
                text: 'FLAG_SECURE: ON' if app.flag_secure_active else 'FLAG_SECURE: OFF'
                font_size: sp(11)
                bold: True
                background_color: (0, 0, 0, 0)
                on_release: app.toggle_flag_secure()
                canvas.before:
                    Color:
                        rgba: (0.06, 0.80, 0.58, 0.25) if app.flag_secure_active else (0.94, 0.27, 0.42, 0.25)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(16), dp(16), dp(16), dp(16)]
                    Color:
                        rgba: (0.06, 0.80, 0.58, 0.8) if app.flag_secure_active else (0.94, 0.27, 0.42, 0.8)
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))
                        width: dp(1)

        # Core Vault Grid Cards
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(16)

                # Card 1: Touchless Biometrics & StrongBox TEE
                GlassCard:
                    size_hint_y: None
                    height: dp(140)
                    Label:
                        text: 'TOUCHLESS BIOMETRIC AUTHENTICATION'
                        font_size: sp(13)
                        bold: True
                        color: (0.08, 0.70, 0.95, 1.0)
                        halign: 'left'
                        text_size: self.size
                    Label:
                        text: 'ML Kit Face Liveness: ACTIVE • Hardware StrongBox Key Sealed'
                        font_size: sp(12)
                        color: app.theme_text
                        halign: 'left'
                        text_size: self.size
                    BoxLayout:
                        spacing: dp(10)
                        SecureButton:
                            text: 'Authenticate Biometrics'
                            on_release: app.show_biometric_popup()
                        Button:
                            text: 'Re-Seed Keystream'
                            background_color: (0.2, 0.25, 0.35, 1)
                            font_size: sp(12)
                            on_release: app.reseed_keystream()

                # Card 2: Onion Routing & Ephemeral Tunnel
                GlassCard:
                    size_hint_y: None
                    height: dp(140)
                    Label:
                        text: 'TOR V3 EPHEMERAL ONION ROUTING'
                        font_size: sp(13)
                        bold: True
                        color: (0.6, 0.4, 0.95, 1.0)
                        halign: 'left'
                        text_size: self.size
                    Label:
                        text: 'Active Hidden Service: 7t9pkwx8...torv3.onion • Latency: 168ms'
                        font_size: sp(12)
                        color: app.theme_text
                        halign: 'left'
                        text_size: self.size
                    BoxLayout:
                        spacing: dp(10)
                        Button:
                            text: 'Switch Circuit'
                            background_color: (0.25, 0.20, 0.45, 1)
                            font_size: sp(12)
                            on_release: app.switch_tor_circuit()
                        Button:
                            text: 'Audit Tor Sockets'
                            background_color: (0.2, 0.25, 0.35, 1)
                            font_size: sp(12)
                            on_release: app.audit_sockets()

                # Card 3: Duress & Panic Wipe Trigger
                GlassCard:
                    size_hint_y: None
                    height: dp(140)
                    Label:
                        text: 'DENIABLE VAULT & HARDWARE PANIC'
                        font_size: sp(13)
                        bold: True
                        color: (0.94, 0.27, 0.42, 1.0)
                        halign: 'left'
                        text_size: self.size
                    Label:
                        text: 'DoD 5220.22-M Multi-Pass Shredder • Out-of-Band Beacon Armed'
                        font_size: sp(12)
                        color: app.theme_text
                        halign: 'left'
                        text_size: self.size
                    BoxLayout:
                        spacing: dp(10)
                        DangerButton:
                            text: 'Emergency Panic Wipe'
                            on_release: app.show_panic_confirmation()
                        Button:
                            text: 'Switch Theme'
                            background_color: (0.2, 0.25, 0.35, 1)
                            font_size: sp(12)
                            on_release: app.cycle_theme()

<BiometricPopupContent@BoxLayout>:
    orientation: 'vertical'
    padding: dp(20)
    spacing: dp(16)
    canvas.before:
        Color:
            rgba: (0.08, 0.09, 0.13, 0.98)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18), dp(18), dp(18), dp(18)]
        Color:
            rgba: (0.06, 0.80, 0.58, 0.8)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(18))
            width: dp(1.5)

    Label:
        text: 'Biometric Face Verification'
        font_size: sp(16)
        bold: True
        color: (0.96, 0.96, 0.98, 1)
        size_hint_y: None
        height: dp(28)

    Label:
        text: 'Align your face in frame. ML Kit hardware-accelerated touchless liveness is verifying micro-movements...'
        font_size: sp(12)
        color: (0.7, 0.75, 0.85, 1)
        halign: 'center'
        text_size: self.size

    ProgressBar:
        max: 100
        value: 100
        size_hint_y: None
        height: dp(12)

    BoxLayout:
        size_hint_y: None
        height: dp(44)
        spacing: dp(12)
        Button:
            text: 'Cancel'
            background_color: (0.2, 0.25, 0.3, 1)
            on_release: app.dismiss_popup()
        SecureButton:
            text: 'Confirm Match'
            on_release: app.complete_biometric_auth()
